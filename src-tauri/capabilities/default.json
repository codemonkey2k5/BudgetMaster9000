{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Full app access for the main window (local UI server + all BM9000 commands)",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "allow-all-app"
  ]
}
